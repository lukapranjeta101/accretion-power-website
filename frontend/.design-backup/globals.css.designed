@import "tailwindcss";
/* User-approved monochrome foundation with cool, restrained accents. */
:root {
  --color-white: #FFFFFF;
  --color-black: #040411;
  --color-blue: #91A9C9;
  --color-navy: #041128;
  --color-slate: #848C9B;
  --color-stone: #B2B4AB;
  --ink: var(--color-black);
  --paper: var(--color-white);
  --accent: var(--color-blue);
  --muted: color-mix(in srgb, var(--color-black) 75%, var(--color-slate));
  --line: color-mix(in srgb, var(--color-stone) 45%, var(--color-white));
  --line-dark: color-mix(in srgb, var(--color-slate) 40%, var(--color-black));
  --scroll: 0;
}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:120px}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}button,a{-webkit-tap-highlight-color:transparent}button{color:inherit}h1,h2,h3,p{margin:0}h1,h2,h3{font-weight:500;letter-spacing:-.055em}p{line-height:1.55}svg{flex-shrink:0}::selection{background:var(--color-black);color:var(--color-white)}:focus-visible{outline:3px solid var(--color-black);outline-offset:5px}main:focus{outline:none}.wrap{width:calc(100% - 112px);max-width:1440px;margin:auto}.section{padding-block:110px}.section-marker,.eyebrow,.hero-caption,.image-meta,.image-label,.step-no,.footer-bottom{font-family:"Courier New",monospace;font-size:11px;font-weight:400;letter-spacing:.045em;line-height:1.5}.section-marker{display:flex;align-items:center;gap:16px;margin-bottom:65px}.tiny-cross{font-family:Arial;font-size:24px;font-weight:300}.eyebrow{letter-spacing:.075em}.muted{color:var(--color-slate)}.skip-link{position:fixed;left:20px;top:-100px;padding:14px;background:var(--color-white);z-index:100}.skip-link:focus{top:10px}.floating-header{position:fixed;top:25px;left:50%;transform:translateX(-50%);z-index:50;width:760px;max-width:calc(100% - 40px);display:flex;align-items:center;justify-content:space-between;border:1px solid color-mix(in srgb, var(--color-white) 20%, transparent);background:var(--color-black);color:var(--color-white);backdrop-filter:blur(18px);border-radius:12px;padding:10px 10px 10px 24px;box-shadow:0 5px 25px color-mix(in srgb, var(--color-black) 20%, transparent)}.brand{display:flex;align-items:center;gap:8px;font-size:24px;font-weight:700;letter-spacing:-1.2px;line-height:1}.brand-power{display:block;font-size:9px;letter-spacing:4.7px;margin-top:6px}.floating-header nav{display:flex;gap:28px;align-items:center;font-size:12px}.floating-header nav>a:not(.nav-contact){padding-block:14px;transition:color .2s}.floating-header nav>a:hover{color:var(--color-white);text-decoration:underline;text-underline-offset:5px}.floating-header .nav-contact{display:flex;gap:24px;align-items:center;background:var(--color-white);color:var(--ink);padding:14px 18px;border-radius:7px}.floating-header .nav-contact:hover{color:var(--ink);background:var(--color-white);box-shadow:inset 0 0 0 2px var(--color-blue)}.menu-toggle{display:none}.hero{height: min(960px,100svh);min-height:740px;position:relative;color:var(--color-white);overflow:hidden;background:var(--color-black)}.hero-photo{filter:grayscale(1);object-fit:cover;object-position:center 57%;transform:translateY(calc(var(--scroll)*.18px)) scale(1.03);will-change:transform}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,color-mix(in srgb, var(--color-black) 50%, transparent) 0%,color-mix(in srgb, var(--color-black) 35%, transparent) 30%,color-mix(in srgb, var(--color-black) 45%, transparent) 55%,var(--color-black) 100%)}.hero-content{position:relative;padding-top:clamp(205px,26vh,300px)}.hero .eyebrow{display:flex;align-items:center;gap:11px}.status-dot{display:inline-block;background:var(--color-blue);border-radius:50%;width:7px;height:7px;box-shadow:0 0 15px var(--color-blue)}.hero h1{font-size:clamp(74px,7.8vw,120px);line-height:.99;margin-top:26px;letter-spacing:-.065em}.hero-bottom{display:flex;align-items:flex-end;justify-content:space-between;margin-top:48px;gap:25px}.hero-bottom p{font-size:17px;color:var(--color-white);line-height:1.5}.action{background:var(--color-black);color:var(--color-white);border-radius:5px;padding:18px 23px;display:inline-flex;align-items:center;justify-content:space-between;gap:42px;font-size:13px;min-height:54px;transition:background .2s,transform .2s}.action:hover{background:var(--color-black);transform:translateY(-2px)}.action-dark{background:var(--ink);color:var(--color-white)}.action-dark:hover{background:var(--color-black)}.hero-caption{position:absolute;bottom:30px;left:0;right:0;display:flex;align-items:center;justify-content:space-between;font-size:10px;border-top:1px solid var(--color-blue);padding-top:22px}.hero-caption a{display:flex;align-items:center;gap:13px}.scroll-circle{border:1px solid var(--color-blue);border-radius:50%;display:grid;place-items:center;width:31px;height:31px;font-size:18px}.caption-plus{padding:0 22px;color:var(--color-white)}h2{font-size:clamp(44px,4.8vw,72px);line-height:1.05}.intro-main{display:grid;grid-template-columns:1.25fr 1fr;gap:10%}.intro-copy{max-width:440px;padding-top:4px}.intro-copy p{font-size:18px}.intro-copy p+p{font-size:15px;color:var(--muted);margin-top:22px}.text-link{display:inline-flex;gap:36px;align-items:center;padding:14px 0;border-bottom:1px solid currentColor;font-size:13px;margin-top:22px}.text-link:hover svg{transform:translate(3px,-3px)}.text-link svg{transition:transform .2s}.value-strip{display:grid;grid-template-columns:repeat(3,1fr);margin-top:85px;border-top:1px solid var(--line);padding-top:27px}.value-strip>div{padding-left:28px;border-left:1px solid var(--line)}.value-strip>div:first-child{padding-left:0;border:0}.value-strip span{font-family:monospace;font-size:11px;color:var(--color-black)}.value-strip h3{font-size:24px;letter-spacing:-.04em;margin:23px 0 8px}.value-strip p{font-size:13px;color:var(--muted)}.products{background:var(--color-white)}.section-heading{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:48px}.section-heading p{max-width:340px;font-size:15px;padding-bottom:5px}.product-tabs{display:flex;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:30px;gap:0;overflow-x:auto;scrollbar-width:thin}.product-tabs button{border:0;border-bottom:3px solid transparent;background:transparent;padding:21px 17px;flex:1;white-space:nowrap;font-size:13px}.product-tabs button:first-child{padding-left:0}.product-tabs button[aria-selected=true]{border-color:var(--ink);font-weight:700}.product-tabs button:hover{background:var(--color-white)}.product-panel{display:grid;grid-template-columns:1.1fr 1fr;min-height:475px;gap:65px;align-items:stretch}.product-image{position:relative;background:var(--color-white);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;overflow:hidden;min-width:0;border-radius:3px;animation:product-in .4s ease}.product-image img{width:92%;height:280px;object-fit:contain;mix-blend-mode:multiply}.image-meta{position:absolute;left:24px;right:24px;top:24px;display:flex;justify-content:space-between;font-size:9px;color:var(--color-black)}.image-label{position:absolute;bottom:25px;left:24px;text-transform:uppercase}.image-cross{position:absolute;bottom:21px;right:24px;font-size:25px;font-weight:300}.product-copy{padding:42px 0;max-width:440px;animation:product-in .4s ease}.product-copy .eyebrow{font-size:10px;color:var(--color-black)}.product-copy h3{font-size:39px;line-height:1.08;white-space:pre-line;margin:23px 0}.product-copy>p:not(.eyebrow){font-size:14px;color:var(--color-black)}.tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:24px}.tags span{border:1px solid var(--color-slate);border-radius:30px;padding:7px 10px;font-size:10px}.product-copy .text-link{margin-top:20px}.custom-note{display:flex;justify-content:space-between;align-items:center;margin-top:28px;border-top:1px solid var(--line);padding-top:24px;font-size:13px}.custom-note a{display:flex;gap:30px;align-items:center}.approach{background:var(--color-black);color:var(--color-white)}.approach .section-marker{color:var(--color-white)}.approach-layout{display:grid;grid-template-columns:1fr 1fr;gap:10%}.approach-title{position:sticky;top:140px;align-self:start}.approach-title>p{font-size:15px;color:var(--color-white);max-width:355px;margin:28px 0}.approach-title h2{font-size:clamp(44px,4.5vw,65px)}.approach-step{display:flex;gap:27px;border-top:1px solid var(--color-black);padding:35px 0 47px}.step-no{color:var(--color-white);padding-top:6px}.approach-step h3{font-size:28px;letter-spacing:-.04em;margin-bottom:20px}.approach-step p{font-size:14px;color:var(--color-white);max-width:370px}.step-plus{margin-left:auto;color:var(--color-slate)}.orbit-art{position:relative;width:200px;height:180px;margin:40px 0 0 45px;display:grid;place-items:center;color:var(--color-blue)}.orbit-art>div{position:absolute;width:160px;height:160px;border:1px solid var(--color-slate);transform:rotateX(55deg) rotate(-30deg);border-radius:50%}.orbit-art>div:nth-child(2){transform:rotateY(55deg) rotate(30deg)}.orbit-art>div:nth-child(3){transform:rotateY(-55deg) rotate(-30deg)}.orbit-art svg{width:45px;height:50px}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:9%;align-items:center}.about-visual{position:relative;min-height:520px;overflow:hidden;border-radius:3px}.about-visual>img{object-fit:cover;object-position:20% center;filter:grayscale(1)}.about-visual:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent,var(--color-black))}.about-image-text{position:absolute;bottom:35px;left:35px;z-index:1;color:var(--color-white);display:flex;align-items:flex-end;gap:30px}.about-image-text>span{font-size:33px;line-height:1.05;letter-spacing:-.04em}.about-copy>.eyebrow{font-size:10px;margin-bottom:25px}.about-copy h2{margin-bottom:30px}.about-copy>p:not(.eyebrow){font-size:15px;color:var(--color-black);max-width:410px;margin-top:20px}.definition{margin-top:42px;border-top:1px solid var(--line);padding-top:22px;display:flex;gap:28px;align-items:center}.definition>span:first-child{font-size:24px;letter-spacing:-1px}.definition>span:last-child{font-family:monospace;font-size:10px;line-height:1.7;color:var(--color-black)}.contact{background:var(--color-white);color:var(--color-black);padding-block:65px 75px}.contact .section-marker{margin-bottom:35px}.contact-heading{display:flex;justify-content:space-between;align-items:center}.contact h2{font-size:clamp(55px,6.7vw,100px)}.contact-arrow{width:108px;height:108px;border:1px solid var(--color-slate);border-radius:50%;display:grid;place-items:center;transition:background .2s}.contact-arrow:hover{background:var(--color-blue);color:var(--color-black)}.contact-arrow svg{width:52px;height:52px}.contact-bottom{display:flex;justify-content:space-between;align-items:flex-end;margin-top:45px}.contact-bottom p{font-size:15px}.footer{background:var(--ink);color:var(--color-white);padding:65px 0 25px}.footer-top{display:grid;grid-template-columns:1fr 1fr 1.4fr auto;gap:25px;align-items:start;padding-bottom:65px}.footer-top>p{font-size:14px;color:var(--color-white)}.footer-top>div{display:flex;flex-direction:column;gap:8px;font-size:12px}.footer-top .eyebrow{font-size:9px;color:var(--color-white);margin-bottom:7px}.footer-top .back-top{font-size:11px}.footer-bottom{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:22px;color:var(--color-white);font-size:9px}.reveal{opacity:1}.reveal.revealed{animation:reveal .85s both cubic-bezier(.2,.7,.2,1)}@keyframes reveal{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}@keyframes product-in{from{opacity:.4;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@media(min-width:1600px){.hero-content{padding-top:270px}}
@media(max-width:1050px){.wrap{width:calc(100% - 64px)}.section{padding-block:85px}.product-panel{gap:35px}.product-copy h3{font-size:32px}.approach-layout{gap:6%}.footer-top{grid-template-columns:1fr 1fr}.footer-top .back-top{justify-self:end}.intro-main{gap:6%}.about-grid{gap:6%}.hero h1{font-size:9vw}}
@media(max-width:899px){.floating-header{top:16px;width:calc(100% - 32px);max-width:none;padding:13px 18px}.brand{font-size:22px}.menu-toggle{display:block;border:0;background:none;font-size:12px;padding:12px}.floating-header nav{display:none;position:absolute;top:calc(100% + 8px);left:0;right:0;padding:24px;background:var(--color-black);border-radius:10px;flex-direction:column;align-items:stretch;gap:4px}.floating-header nav.nav-open{display:flex}.floating-header .nav-contact{margin-top:10px;justify-content:space-between}.hero{min-height:720px;height:90svh}.hero-content{padding-top:210px}.hero h1{font-size:clamp(65px,9.3vw,85px)}.hero-bottom{margin-top:36px}.intro-main{grid-template-columns:1fr;gap:30px}.intro-copy{max-width:600px}.value-strip{margin-top:50px}.value-strip h3{font-size:21px}.product-tabs button{padding:20px 16px}.product-panel{gap:26px}.product-copy h3{font-size:29px}.product-image img{height:220px}.approach-layout{grid-template-columns:1fr;gap:55px}.approach-title{position:static}.approach-title>p{max-width:500px}.orbit-art{display:none}.approach-step p{max-width:600px}.about-grid{grid-template-columns:1fr;gap:45px}.about-visual{min-height:390px}.about-copy>p:not(.eyebrow){max-width:600px}.section-marker{margin-bottom:45px}.contact-arrow{width:80px;height:80px}.contact-arrow svg{width:35px;height:35px}}
@media(max-width:600px){.wrap{width:calc(100% - 40px)}.section{padding-block:65px}.hero{height:92svh;min-height:700px}.hero-content{padding-top:190px}.hero h1{font-size:clamp(53px,12vw,72px);margin-top:25px}.hero .eyebrow{font-size:9px;letter-spacing:.02em}.hero-bottom{align-items:flex-start;flex-direction:column;gap:26px}.hero-bottom p{font-size:14px}.hero-photo{object-position:60% center}.hero-caption>span{display:none}.hero-caption{bottom:22px}.action{padding:16px 19px;font-size:12px;gap:35px}.intro-copy p{font-size:17px}h2{font-size:43px}.value-strip{grid-template-columns:1fr;padding-top:0;border:0;gap:0}.value-strip>div,.value-strip>div:first-child{position:relative;padding:24px 0 24px 40px;border:0;border-top:1px solid var(--line)}.value-strip span{position:absolute;top:28px;left:0}.value-strip h3{margin:0 0 7px}.section-heading{display:block;margin-bottom:30px}.section-heading p{margin-top:25px;font-size:14px}.product-tabs{margin-right:-20px}.product-panel{grid-template-columns:1fr;gap:0}.product-image{min-height:310px}.product-copy{padding:32px 0 15px}.product-copy h3{font-size:36px}.image-meta{font-size:8px}.custom-note{align-items:flex-start;gap:18px;flex-direction:column}.custom-note a{font-size:12px}.approach-step{gap:18px;padding-bottom:32px}.approach-step h3{font-size:25px}.approach-step p{font-size:13px}.about-visual{min-height:360px}.about-image-text{left:25px;bottom:25px;gap:20px}.about-image-text>span{font-size:29px}.definition{gap:20px}.definition>span:last-child{font-size:9px}.contact h2{font-size:46px}.contact-arrow{display:none}.contact-bottom{flex-direction:column;align-items:flex-start;gap:26px;margin-top:30px}.contact-bottom p{font-size:13px}.footer{padding-top:45px}.footer-top{grid-template-columns:1fr;gap:30px;padding-bottom:40px}.footer-top .back-top{justify-self:start}.footer-bottom{flex-direction:column;gap:13px;font-size:9px}.section-marker{font-size:9px;gap:10px;margin-bottom:35px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation:none!important;transition:none!important}.hero-photo{transform:none!important}}

/* Monochrome composition. Palette color is reserved for small, deliberate accents. */
::selection{background:var(--color-blue);color:var(--color-black)}
.floating-header{background:color-mix(in srgb,var(--color-black) 95%,transparent)}
.floating-header .nav-contact:hover{background:var(--color-blue);box-shadow:none}
.hero .action{background:var(--color-blue);color:var(--color-black)}
.hero .action:hover{background:var(--color-white)}
.hero :focus-visible,.floating-header :focus-visible,.approach :focus-visible,.footer :focus-visible{outline-color:var(--color-blue)}
.action:hover{background:var(--color-navy);color:var(--color-white)}
.approach .action{background:var(--color-white);color:var(--color-black)}
.approach .action:hover{background:var(--color-blue)}
.hero-caption,.scroll-circle,.approach-step,.footer-bottom{border-color:var(--line-dark)}
.status-dot{box-shadow:0 0 15px color-mix(in srgb,var(--color-blue) 35%,transparent)}
.caption-plus,.approach .tiny-cross,.step-no,.orbit-art{color:var(--color-blue)}
.orbit-art>div{border-color:var(--color-slate)}
.orbit-art>div:nth-child(2){border-color:var(--color-blue)}
.orbit-art>div:nth-child(3){border-color:var(--color-stone)}
.approach-title>p,.approach-step p,.footer-top>p,.footer-bottom{color:var(--color-stone)}
.footer-top .eyebrow{color:var(--color-blue)}
.products{background:color-mix(in srgb,var(--color-stone) 9%,var(--color-white));border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.product-image{background:var(--color-white)}
.product-tabs button[aria-selected=true]{border-color:var(--color-navy);box-shadow:inset 0 -3px var(--color-blue)}
.product-tabs button:hover{background:color-mix(in srgb,var(--color-blue) 18%,var(--color-white))}
.tags span{border-color:var(--line)}
.product-copy>p:not(.eyebrow),.about-copy>p:not(.eyebrow),.image-meta,.definition>span:last-child{color:var(--muted)}
.image-cross{color:var(--color-navy)}
.text-link:hover{color:var(--color-navy);border-color:var(--color-blue)}
.value-strip span{color:var(--color-navy)}
.contact{border-top:1px solid var(--line)}
.contact .tiny-cross{color:var(--color-navy)}
.contact-arrow{background:var(--color-blue);border-color:var(--color-blue);color:var(--color-black)}
.contact-arrow:hover{background:var(--color-black);border-color:var(--color-black);color:var(--color-white)}
.contact .action-dark{background:var(--color-black);color:var(--color-white)}
.contact .action-dark:hover{background:var(--color-navy)}

/* A fixed, compact navigation rail. */
.floating-header{
  top:4px;
  width:660px;
  padding:2px 8px 2px 18px;
  border-radius:999px;
}
.floating-header .brand{font-size:20px}
.floating-header .brand>svg{width:24px;height:27px}
.floating-header .brand-power{letter-spacing:3.8px;margin-top:3px}
.floating-header nav{gap:16px}
.floating-header nav>a{min-height:36px;display:flex;align-items:center}
.floating-header .nav-contact{padding:9px 16px;gap:14px;border-radius:999px}
@media(max-width:899px){
  .floating-header{width:calc(100% - 44px);padding:2px 16px;border-radius:999px}
  .floating-header .brand{font-size:19px}
  .floating-header .menu-toggle{min-height:44px;min-width:64px}
  .floating-header nav{gap:4px}
  .floating-header .nav-contact{padding:14px 18px;gap:24px}
}
