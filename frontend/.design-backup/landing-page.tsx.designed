"use client";

import Image from "next/image";
import { useEffect, useRef, useState } from "react";

const email = "benjamin.vietmeier@accretionpower.com";
const products = [
  { name: "Epoxy components", image: "epoxy.png", label: "ENGINEERED INSULATION", title: "Small components.\nCritical performance.", description: "Standoffs, insulators, thru bushings, and wall bushings for switchgear applications. Manufactured at our facility in India, with in-house tooling for custom designs.", tags: ["Standoffs", "LV / MV insulators", "Bushings"] },
  { name: "Porcelain products", image: "porcelain.png", label: "PROVEN MATERIALS", title: "Built to insulate.\nMade to endure.", description: "Porcelain standoffs, outdoor distribution insulators, ceramics, and transformer bushings. Find the right fit for your electrical application.", tags: ["Standoffs", "Outdoor distribution", "Transformer bushings"] },
  { name: "Composite insulators", image: "composite.png", label: "OUTDOOR APPLICATIONS", title: "Insulation for\nthe world outside.", description: "Composite insulators for outdoor electrical applications. Work directly with our team to align your component selection with your project requirements.", tags: ["Composite insulation", "Outdoor applications"] },
  { name: "Copper", image: "copper.png", label: "CONDUCTIVITY, CONFIGURED", title: "Your connection.\nYour configuration.", description: "C110 copper bus bar in bare, tin-plated, or silver-plated finishes. Custom cutting, milling, punching, and bending to suit your design.", tags: ["C110 copper", "Bus bar", "Custom fabrication"] },
  { name: "Bus boots", image: "boots.png", label: "SWITCHGEAR COMPONENTS", title: "The details that\ncomplete the system.", description: "Explore bus boots for your switchgear assembly. Share your application and drawings with our team to discuss the right configuration.", tags: ["Bus boots", "Application support"] },
  { name: "Castings", image: "castings.png", label: "MANUFACTURED TO YOUR DESIGN", title: "Complex requirements.\nConsidered solutions.", description: "Aluminum permanent mold and die castings for electrical applications, including current-carrying and pressure-retaining designs to OEM requirements.", tags: ["Permanent mold", "Die casting", "OEM designs"] },
];
function Arrow({ diagonal = false }: { diagonal?: boolean }) { return <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={diagonal ? "M6 18 18 6M6 6h12v12" : "M4 12h15m-6-6 6 6-6 6"} stroke="currentColor" strokeWidth="1.6" /></svg>; }
function Mark() { return <svg width="34" height="38" viewBox="0 0 34 38" fill="none" aria-hidden="true"><path d="M2 32 15 5h6L8 32H2ZM13 32l9-19 10 19h-7l-4-8-4 8h-4Z" fill="currentColor"/></svg>; }
function LinkButton({ href, children, dark = false }: { href: string; children: React.ReactNode; dark?: boolean }) { return <a className={`action ${dark ? "action-dark" : ""}`} href={href}>{children}<Arrow /></a>; }
export default function LandingPage() {
  const [menu, setMenu] = useState(false);
  const [active, setActive] = useState(0);
  const root = useRef<HTMLDivElement>(null);
  const toggle = useRef<HTMLButtonElement>(null);
  const product = products[active];
  useEffect(() => {
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const observer = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add("revealed"); observer.unobserve(entry.target); } }), { threshold: .12 });
    root.current?.querySelectorAll(".reveal").forEach(el => observer.observe(el));
    let frame = 0;
    const updateScroll = () => {
      const y = Math.max(0, window.scrollY);
      root.current?.style.setProperty("--scroll", motion.matches ? "0" : String(y));
      frame = 0;
    };
    const scroll = () => { if (!frame) frame = requestAnimationFrame(updateScroll); };
    updateScroll();
    window.addEventListener("scroll", scroll, { passive: true });
    motion.addEventListener("change", scroll);
    const desktop = window.matchMedia("(min-width: 900px)");
    const close = () => setMenu(false);
    desktop.addEventListener("change", close);
    return () => { observer.disconnect(); motion.removeEventListener("change", scroll); window.removeEventListener("scroll", scroll); cancelAnimationFrame(frame); desktop.removeEventListener("change", close); };
  }, []);
  return <div ref={root} id="top">
    <a className="skip-link" href="#main-content">Skip to content</a>
    <header className="floating-header" onKeyDown={event => { if (event.key === "Escape") { setMenu(false); toggle.current?.focus(); } }}>
      <a className="brand" href="#top" aria-label="Accretion Power home"><Mark /><span>accretion<span className="brand-power">POWER</span></span></a>
      <button ref={toggle} className="menu-toggle" aria-label={menu ? "Close navigation menu" : "Open navigation menu"} aria-expanded={menu} aria-controls="primary-nav" onClick={() => setMenu(!menu)}>{menu ? "Close −" : "Menu +"}</button>
      <nav id="primary-nav" aria-label="Main navigation" className={menu ? "nav-open" : ""}>
        {[ ["Products", "products"], ["Our approach", "approach"], ["About us", "about"] ].map(([label, id]) => <a key={id} href={`#${id}`} onClick={() => setMenu(false)}>{label}</a>)}
        <a className="nav-contact" href="#contact" onClick={() => setMenu(false)}>Let’s talk <Arrow diagonal /></a>
      </nav>
    </header>
    <main id="main-content" tabIndex={-1}>
      <section className="hero" aria-labelledby="hero-heading">
        <Image className="hero-photo" src="/images/power-lines.jpg" alt="Transmission lines stretching toward the horizon at sunset" fill preload loading="eager" sizes="100vw"/>
        <div className="hero-shade" />
        <div className="hero-content wrap">
          <p className="eyebrow"><span className="status-dot"/> THE COMPONENTS BEHIND YOUR POWER.</p>
          <h1 id="hero-heading">Powering progress.<br/>Part by part.</h1>
          <div className="hero-bottom"><p>Electrical components. Reliable partnerships.<br/>A stronger supply chain for what comes next.</p><LinkButton href="#products">Discover our products</LinkButton></div>
        </div>
        <div className="hero-caption wrap"><a href="#intro"><span className="scroll-circle">↓</span> SCROLL TO EXPLORE</a><span>PITTSBURGH, PA <span className="caption-plus">+</span> GLOBAL REACH</span></div>
      </section>
      <section className="intro section wrap" id="intro">
        <div className="section-marker"><span className="tiny-cross">+</span> 01 / BUILT AROUND YOUR GROWTH</div>
        <div className="intro-main reveal"><h2>Progress starts with<br/>the right <span className="muted">partner.</span></h2><div className="intro-copy"><p>Behind every reliable power system are components you can count on. And people who understand what’s at stake.</p><p>Accretion Power brings electrical products, manufacturing expertise, and personal service together for North American utilities and global OEMs.</p><a className="text-link" href="#approach">A better way to source <Arrow diagonal/></a></div></div>
        <div className="value-strip reveal"><div><span>01</span><h3>Quality components.</h3><p>Standard products. Custom capabilities.</p></div><div><span>02</span><h3>A resilient supply chain.</h3><p>Global manufacturing. Local inventory.</p></div><div><span>03</span><h3>A direct connection.</h3><p>Real expertise. Personal accountability.</p></div></div>
      </section>
      <section className="products section" id="products">
        <div className="wrap"><div className="section-marker"><span className="tiny-cross">+</span> 02 / OUR PRODUCTS</div><div className="section-heading reveal"><h2>Every part.<br/>A bigger purpose.</h2><p>From insulation to conduction.<br/>The building blocks of your next project.</p></div>
          <div className="product-tabs" role="tablist" aria-label="Product families">{products.map((item, index) => <button id={`tab-${index}`} key={item.name} role="tab" aria-selected={active === index} aria-controls="product-panel" tabIndex={active === index ? 0 : -1} onClick={() => setActive(index)} onKeyDown={event => { let next = index; if (event.key === "ArrowRight") next = (index + 1) % products.length; else if (event.key === "ArrowLeft") next = (index + products.length - 1) % products.length; else if (event.key === "Home") next = 0; else if (event.key === "End") next = products.length - 1; else return; event.preventDefault(); setActive(next); document.getElementById(`tab-${next}`)?.focus(); }}>{item.name}</button>)}</div>
          <div id="product-panel" className="product-panel" role="tabpanel" aria-labelledby={`tab-${active}`} tabIndex={0}><div className="product-image" key={product.image}><div className="image-meta"><span>ACCRETION / {String(active + 1).padStart(2, "0")}</span><span>PRODUCT SPOTLIGHT ↗</span></div><Image src={`/images/${product.image}`} width={900} height={500} loading="eager" alt={`${product.name} from Accretion Power’s product range`} sizes="(max-width: 800px) 90vw, 45vw"/><span className="image-label">{product.name}</span><span className="image-cross">+</span></div><div className="product-copy" key={product.name}><p className="eyebrow">{product.label}</p><h3>{product.title}</h3><p>{product.description}</p><div className="tags">{product.tags.map(tag => <span key={tag}>{tag}</span>)}</div><a className="text-link" href={`mailto:${email}?subject=${encodeURIComponent(`Enquiry: ${product.name}`)}`}>Discuss your requirements <Arrow diagonal/></a></div></div>
          <div className="custom-note"><span>Have a drawing? Let’s make it a conversation.</span><a href="#contact">Talk to our team <Arrow/></a></div>
        </div>
      </section>
      <section id="approach" className="approach section"><div className="wrap"><div className="section-marker"><span className="tiny-cross">+</span> 03 / THE ACCRETION ADVANTAGE</div><div className="approach-layout"><div className="approach-title reveal"><h2>More certainty.<br/>Less complexity.</h2><p>Your purchasing process should move your business forward. We help connect the right manufacturing capabilities to the right requirements.</p><LinkButton href="#contact">Build a better supply chain</LinkButton><div className="orbit-art" aria-hidden="true"><div/><div/><div/><Mark/></div></div><div className="approach-steps">{[
          ["Manufacturing, connected.", "Our own epoxy manufacturing facility in India, supported by a wider network of manufacturers. One partner to help simplify procurement."],
          ["Closer to your next project.", "Locally managed inventory in Pennsylvania helps support shorter lead times and takes pressure off your purchasing team."],
          ["Built for your requirements.", "In-house tooling for epoxy components and custom copper fabrication help turn your drawings into a practical production conversation."],
          ["People, not handoffs.", "Work directly with Ben Vietmeier and a team with switchgear experience. Clear communication from the first requirement to the next step."],
        ].map(([title, description], i) => <article className="approach-step reveal" key={title}><span className="step-no">0{i+1}</span><div><h3>{title}</h3><p>{description}</p></div><span className="step-plus">+</span></article>)}</div></div></div></section>
      <section id="about" className="about section wrap"><div className="section-marker"><span className="tiny-cross">+</span> 04 / GROWTH, TOGETHER</div><div className="about-grid"><div className="about-visual reveal"><Image src="/images/power-lines.jpg" alt="Electrical infrastructure connecting communities" fill sizes="(max-width: 800px) 90vw, 45vw"/><div className="about-image-text"><Mark/><span>Small parts.<br/>Lasting connections.</span></div></div><div className="about-copy reveal"><p className="eyebrow">PITTSBURGH ROOTS. GLOBAL CAPABILITIES.</p><h2>Your growth.<br/>Our purpose.</h2><p>Accretion means growth through the addition of smaller parts. It’s also how we think about partnership: every component, every conversation, every project adds up.</p><p>Based in Pittsburgh, Pennsylvania, we supply electrical products with a simple focus—helping you build with confidence.</p><a className="text-link" href="#contact">Meet your next partner <Arrow diagonal/></a><div className="definition"><span>ac·cre·tion</span><span>/əˈkrēSHən/ &nbsp; noun<br/>Growth through gradual addition.</span></div></div></div></section>
      <section className="contact section" id="contact"><div className="wrap"><div className="section-marker"><span className="tiny-cross">+</span> LET’S BUILD WHAT’S NEXT</div><div className="contact-heading reveal"><h2>Great things start<br/>with a connection.</h2><a className="contact-arrow" href={`mailto:${email}`} aria-label="Email Accretion Power"><Arrow diagonal/></a></div><div className="contact-bottom"><p>Bring your drawings, part list, or next big challenge.<br/>Let’s put the right pieces together.</p><LinkButton href={`mailto:${email}?subject=Project%20enquiry`} dark>Start a conversation</LinkButton></div></div></section>
    </main>
    <footer className="footer"><div className="wrap"><div className="footer-top"><a className="brand" href="#top" aria-label="Accretion Power home"><Mark/><span>accretion<span className="brand-power">POWER</span></span></a><p>Quality components.<br/>Stronger connections.</p><div><span className="eyebrow">GET IN TOUCH</span><a href={`mailto:${email}`}>{email}</a><a href="tel:+14125106454">+1 412 510 6454</a></div><a className="back-top" href="#top">Back to top ↑</a></div><div className="footer-bottom"><span>© {new Date().getFullYear()} Accretion Power, LLC.</span><span>Pittsburgh, Pennsylvania · Serving North America & global OEMs</span></div></div></footer>
  </div>;
}
